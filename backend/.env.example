DJANGO_SECRET_KEY=resto-django-production-secure-key-998877665544332211
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Supabase PostgreSQL database connection (pooled or direct)
# Example: postgresql://postgres.xxxx:your-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
