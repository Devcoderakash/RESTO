# =====================================================================
# RESTO V2 NODE.JS BACKEND — ENVIRONMENT CONFIGURATION TEMPLATE
# =====================================================================

NODE_ENV=development
PORT=5001

# Supabase API & Project Configuration
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Supabase Storage Configuration
SUPABASE_STORAGE_BUCKET=resto-media

# Native PostgreSQL Connection Pooler (Supabase Port 6543 for queries)
# Note: search_path=resto_v2 isolates all queries to the V2 schema
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require&options=-c%20search_path=resto_v2

# Direct / Session PostgreSQL Connection (Supabase Port 5432 for persistent LISTEN/NOTIFY)
# CRITICAL: Transaction Pooler (port 6543) does NOT support LISTEN; use direct or session pooler (port 5432)
DIRECT_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require&options=-c%20search_path=resto_v2

DATABASE_SCHEMA=resto_v2
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000

# Application Secrets
TRACKING_TOKEN_SECRET=resto-demo-secret-key-1234567890
STAFF_JWT_SECRET=resto-staff-jwt-secret-secure-random-bytes-512

# Allowed Client Origins for CORS
CLIENT_ORIGINS=http://localhost:5173,http://localhost:5174,https://resto-frontend.vercel.app,https://resto-dashboard.vercel.app

# Realtime SSE Streaming Configuration
SSE_HEARTBEAT_INTERVAL_MS=5000
SSE_MAX_STREAM_DURATION_MS=20000

