# =====================================================================
# RESTO V2 NODE.JS BACKEND — CLOUD STAGING ENVIRONMENT TEMPLATE (.env.staging)
# =====================================================================
# Strict isolation: Dedicated Supabase staging project & Render staging service
# DO NOT populate with production credentials. Use placeholder/staging values only.
# =====================================================================

NODE_ENV=staging
PORT=5005

# ---------------------------------------------------------------------
# Supabase Staging API & Project Configuration
# (Separate project dedicated to RESTO V2, NOT production zmpthsiiouukjjyrbpnz)
# ---------------------------------------------------------------------
STAGING_SUPABASE_URL=https://<staging-project-ref>.supabase.co
STAGING_SUPABASE_ANON_KEY=eyJhbGciOi...<staging-anon-key>...
STAGING_SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...<staging-service-role-key>...
SUPABASE_STORAGE_BUCKET=resto-media

# Backward-compatibility aliases for local staging verification:
SUPABASE_URL=https://<staging-project-ref>.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...<staging-anon-key>...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...<staging-service-role-key>...

# ---------------------------------------------------------------------
# Database Connections (PostgreSQL 16)
# ---------------------------------------------------------------------
# 1. Transaction Pooler (Port 6543) - For standard transactional API queries
STAGING_DATABASE_URL=postgresql://postgres.<staging-project-ref>:[STAGING_DB_PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require&options=-c%20search_path=resto_v2
DATABASE_URL=postgresql://postgres.<staging-project-ref>:[STAGING_DB_PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require&options=-c%20search_path=resto_v2

# 2. Direct / Session Pooler (Port 5432) - CRITICAL FOR PERSISTENT LISTEN/NOTIFY
# Supabase transaction pooler (port 6543) DOES NOT support LISTEN/NOTIFY.
# Port 5432 direct or session connection is required for RealtimeBridge.
STAGING_DIRECT_DATABASE_URL=postgresql://postgres:[STAGING_DB_PASSWORD]@db.<staging-project-ref>.supabase.co:5432/postgres?sslmode=require&options=-c%20search_path=resto_v2
DIRECT_DATABASE_URL=postgresql://postgres:[STAGING_DB_PASSWORD]@db.<staging-project-ref>.supabase.co:5432/postgres?sslmode=require&options=-c%20search_path=resto_v2

DATABASE_SCHEMA=resto_v2
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000

# ---------------------------------------------------------------------
# Security, Tokens & Authentication
# ---------------------------------------------------------------------
JWT_SECRET=staging-jwt-secret-replace-with-cryptographic-random-256bit
STAFF_JWT_SECRET=staging-jwt-secret-replace-with-cryptographic-random-256bit
TRACKING_TOKEN_SECRET=staging-tracking-token-secret-replace-with-random-256bit
JWT_ISSUER=resto-backend-staging
JWT_AUDIENCE=resto-dashboard-staging
JWT_EXPIRY=24h

# Demo authentication is STRICTLY DISABLED in staging & production
ALLOW_DEMO_AUTH=false

# ---------------------------------------------------------------------
# CORS Allowed Client Origins
# ---------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://resto-frontend-staging.onrender.com,https://resto-dashboard-staging.onrender.com
CLIENT_ORIGINS=https://resto-frontend-staging.onrender.com,https://resto-dashboard-staging.onrender.com

# ---------------------------------------------------------------------
# Realtime SSE Streaming Configuration
# ---------------------------------------------------------------------
SSE_HEARTBEAT_INTERVAL_MS=5000
SSE_MAX_STREAM_DURATION_MS=20000

