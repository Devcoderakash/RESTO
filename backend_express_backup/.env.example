# Supabase project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=
# Supabase anon/public key. Used only for Supabase Auth sign-in and token validation.
SUPABASE_ANON_KEY=
# Supabase service_role key. Server only; never expose or prefix with a frontend variable.
SUPABASE_SERVICE_ROLE_KEY=
# A random secret of at least 32 characters used to derive order tracking tokens.
TRACKING_TOKEN_SECRET=
# Comma-separated browser origins allowed by CORS.
CLIENT_ORIGINS=http://localhost:5173,http://localhost:5174
PORT=5000
NODE_ENV=development
